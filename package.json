{
  "name": "trustvault",
  "version": "1.0.0",
  "private": true,
  "description": "Secure document sharing with a tamper-proof hash-chained audit trail",
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "start": "node server/index.js",
    "build": "npm run build --prefix client",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "seed": "node server/seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.16.3"
  }
}
