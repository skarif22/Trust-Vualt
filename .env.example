PORT=8080
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Production / Docker: postgres://user:pass@host:5432/trustvault
# Local without Postgres: leave unset to use embedded PGlite (tests + demo)
DATABASE_URL=
SEED_ON_START=true
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=8388608
